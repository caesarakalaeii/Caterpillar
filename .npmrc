# Dependency changes are reviewed code changes (see DESIGN.md §15 — pi API churn).
save-exact=true
min-release-age=2

# npm derives `omit=dev` from NODE_ENV=production, which is set in some of the
# environments this repo is checked and built in. That silently skips the
# typescript devDependency, and `npm run check` then fails with a bare
# "tsc: command not found" — an install-time decision surfacing as a missing
# binary two commands later. The gate must not depend on an ambient variable, so
# ask for the dev tree explicitly: `include` beats the NODE_ENV-derived `omit`.
# The runtime image still drops devDependencies, because the Dockerfile's deps
# stage passes --omit=dev on the command line, which in turn beats this file.
# That is where "do not ship the compiler" belongs — not in the ambient env.
include=dev
