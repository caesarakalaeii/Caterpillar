# Dependency changes are reviewed code changes (see DESIGN.md §15 — pi API churn).
save-exact=true
min-release-age=2

# Install devDependencies even when NODE_ENV=production is set in the environment.
# npm infers --omit=dev from NODE_ENV, which silently drops typescript and leaves
# `npm run check` failing with `tsc: command not found` (exit 127) rather than a type
# error. The container images that run the supervisor set NODE_ENV=production, so a
# checkout there could not type-check itself. An explicit empty `omit` outranks the
# inference. Production images drop dev deps via an explicit `npm ci --omit=dev`
# instead, which still overrides this, so image size is unaffected.
#
# It must be `omit=` and NOT the tidier-looking `include=dev`: `include` outranks
# `omit`, so `include=dev` would defeat the Dockerfile's `npm ci --omit=dev` and ship
# typescript into the runtime image — the exact bloat its separate deps stage exists to
# avoid. npm warns that the empty value is an invalid config; it is nonetheless the
# documented way to clear the list, and it is honoured. The warning is the cost of
# keeping the production tree clean.
omit=
