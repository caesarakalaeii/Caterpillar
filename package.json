{
  "name": "caterpillar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Long-running autonomous coding agent supervisor. See DESIGN.md.",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "caterpillar": "./dist/index.js",
    "caterpillar-cred": "./dist/cli/credential-helper.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "node --test 'src/**/*.test.ts'",
    "start": "node src/index.ts",
    "verify:github-app": "node src/cli/verify-github-app.ts",
    "verify:reviewer": "node src/cli/verify-reviewer.ts",
    "verify:forgejo": "node src/cli/verify-forgejo.ts",
    "verify:vikunja": "node src/cli/verify-vikunja.ts",
    "verify:github-issues": "node src/cli/verify-github-issues.ts",
    "verify:discord": "node src/cli/verify-discord.ts",
    "verify:manifests": "node src/cli/verify-manifests.ts",
    "verify:cluster-read": "node src/cli/verify-cluster-read.ts",
    "discord:register": "node src/cli/register-commands.ts",
    "llm:login": "node src/cli/llm-login.ts",
    "llm:holder": "node src/cli/llm-holder.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.1",
    "@earendil-works/pi-ai": "0.84.1",
    "ioredis": "6.0.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "22.18.12",
    "typescript": "5.9.3"
  }
}
