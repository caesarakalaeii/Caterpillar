{
  "name": "caterpillar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Long-running autonomous coding agent supervisor. See DESIGN.md.",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "caterpillar": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types 'src/**/*.test.ts'",
    "start": "node --experimental-strip-types src/index.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.1",
    "@earendil-works/pi-ai": "0.84.1",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "22.18.12",
    "typescript": "5.9.3"
  }
}
